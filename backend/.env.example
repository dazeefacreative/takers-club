# Database — create these via cPanel > MySQL Databases first.
# cPanel prefixes both the DB name and user with your cPanel username,
# e.g. DB_NAME=takebloz_takers_club, DB_USER=takebloz_tcadmin
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Secret code for the one-time first-admin page at /admin/setup. The page
# locks itself permanently once an admin exists.
ADMIN_SETUP_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=sk_test_b06a2ffe6a5ae7ac98dc59e72b3a68eecb40c348

# CORS — comma-separated list of allowed origins (production domain + localhost for dev)
FRONTEND_URL=http://localhost:5174,https://takersclub.store

# Primary public URL used for Paystack callback redirect (single URL, no commas)
APP_URL=https://takersclub.store

# Email — SMTP creds used to send order receipts + admin order alerts.
# SMTP_HOST must be the hosting SERVER's hostname (see the cPanel Terminal
# prompt, e.g. takebloz@business196 → business196.web-hosting.com), NOT
# mail.takersclub.store — the mail server's TLS certificate only covers
# *.web-hosting.com, so the domain name fails certificate checks.
# Mail still goes out "from" SMTP_FROM.
SMTP_HOST=business196.web-hosting.com
SMTP_PORT=465
SMTP_USER=support@takersclub.store
SMTP_PASS=
SMTP_FROM=Takers Club <support@takersclub.store>
ADMIN_EMAIL=admin@takersclub.store
# Server
PORT=3000
NODE_ENV=production
